# Binance.US API credentials - trading permission only, NO withdrawal permission.
# Same account as the DASH/XRP/UNI bots (keys are account-scoped, not symbol-scoped),
# but this is a fully separate .env/state/service - changes here never touch them.
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=

SYMBOL=HBARUSDT

GRID_MODE=hybrid
PILOT_POINTS=

# Narrow pilot around the 2026-09-30 launch price ($0.1083-0.1088):
#   - DENSE_STEP ~2%, DENSE_SELL_OFFSET ~4% - wider offset than spacing,
#     per the same backtest conclusions used for UNI/DASH/XRP (see
#     PROJECT_STATUS.md "Grid parameter research").
#   - ANCHOR_LOW must be strictly below DENSE_LOW (config.py enforces this -
#     a real crash-buffer rung is mandatory on the low side, unlike the
#     high side, where ANCHOR_HIGH = DENSE_HIGH means "no upper anchor zone").
ANCHOR_LOW=0.08
ANCHOR_HIGH=0.13
ANCHOR_STEP=0.015
DENSE_LOW=0.095
DENSE_HIGH=0.13
DENSE_SELL_OFFSET=0.0044
DENSE_STEP=0.0022

# $57.25 at launch - the account's free USDT at the time, no buffer left
# for DASH's own reserved-pool auto-redeploy (accepted risk).
TOTAL_CAPITAL_USDT=57.25
REFERENCE_PRICE=0.1083
DCA_EXPONENT=1.0

BULK_AMOUNT_USDT=0
BULK_SELL_HIGH=0.13
BULK_SELL_STEP=0.0044

MAX_OPEN_ORDERS=190

# Proportional to HBAR's ~$0.108 price and $0.00001 tick.
TAKER_AVOIDANCE_BUFFER=0.0005

# Off: only ~17 levels against a 200 cap, nothing to free by coarsening.
ZONE_SHIFT_ENABLED=false
ZONE_SHIFT_INTERVAL_HOURS=2
NEAR_MARKET_BAND_PCT=0.10
CONSOLIDATION_STEP=0.0044

# Off by default until offline-tested, same convention as UNI/DASH.
CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_DROP_PCT=0.15
CIRCUIT_BREAKER_WINDOW_HOURS=6
CIRCUIT_BREAKER_RESUME_PCT=0.05

# Safety switch. true = simulate orders only, no real trades placed.
DRY_RUN=true

PROFIT_RESERVE_RATIO=0.5
REINVEST_BAND_PCT=0.04

POLL_INTERVAL_SECONDS=120

STATE_FILE=state.json
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
HEARTBEAT_FILE=heartbeat.json
LEDGER_FILE=trades.csv
